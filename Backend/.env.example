# ==========================================
# AirAware Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Authentication (JWT)
JWT_SECRET=replace-with-a-secure-random-32-character-secret
JWT_EXPIRY=7d

# PostgreSQL Database Connection (Supabase Pooler / Direct)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Supabase REST / IoT Sensor Service
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_TABLE=sensor_readings

# Map Configuration (CARTO basemaps API key)
CARTO_API_KEY=your_carto_api_key_here

# Google AI Studio / Gemini API
# Model: gemini-2.5-flash-lite / gemini-1.5-flash
GEMINI_API_KEY=your_google_ai_studio_api_key_here
